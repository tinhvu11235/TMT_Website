# For pnpm dev on the host. Copy this file to apps/web/.env.local.
# Docker Compose uses the separate .env.example at the repository root.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CMS_URL=http://localhost:8055
CMS_INTERNAL_URL=http://localhost:8055
DIRECTUS_STATIC_TOKEN=
REVALIDATION_SECRET=replace-with-a-random-local-secret
ENABLE_SITE_EDITOR=false
CONTACT_RATE_LIMIT_WINDOW_MS=60000
CONTACT_RATE_LIMIT_MAX=5
