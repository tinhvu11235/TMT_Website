# Docker Compose only. For pnpm dev, use apps/web/.env.example instead.
POSTGRES_DB=construction_cms
POSTGRES_USER=directus
POSTGRES_PASSWORD=change-me

DIRECTUS_KEY=replace-with-strong-random-key
DIRECTUS_SECRET=replace-with-strong-random-secret
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me-now
DIRECTUS_PUBLIC_URL=http://localhost:8055

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CMS_URL=http://localhost:8055
CMS_INTERNAL_URL=http://directus:8055
DIRECTUS_STATIC_TOKEN=

CONTACT_RATE_LIMIT_WINDOW_MS=60000
CONTACT_RATE_LIMIT_MAX=5
REVALIDATION_SECRET=change-me-revalidation-secret
ENABLE_SITE_EDITOR=false
# Reserved for a future SMTP integration; not consumed by the current code.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
